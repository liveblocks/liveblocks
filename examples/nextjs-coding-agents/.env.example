# https://liveblocks.io/dashboard/apikeys
LIVEBLOCKS_SECRET_KEY=

# Cursor API key the agent runs on. Every chat in this deployment uses it, so
# for a team use a service-account key (Cursor dashboard -> Team -> API Keys)
# rather than a personal one. Cloud agent runs are billed to this key.
# The Cursor GitHub App must be granted access to the repositories people
# will pick: https://cursor.com/dashboard -> Integrations -> GitHub.
CURSOR_API_KEY=

# People sign in with GitHub. Create an OAuth App at
# https://github.com/settings/developers with the callback URL
#   <your origin>/api/auth/callback/github
# and paste its credentials here. AUTH_SECRET can be any random string
# (`openssl rand -base64 32`).
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Who can talk to the agent. Members of this GitHub organization get write
# access; anyone else who signs in can only watch. Add individual logins with
# GITHUB_ALLOWED_USERS (comma-separated). If both are empty, everyone who
# can sign in is a member, which is only sensible for local development.
GITHUB_ALLOWED_ORG=
GITHUB_ALLOWED_USERS=

# Optional: default model for new chats (people can switch per chat).
CURSOR_MODEL=composer-2.5

# Optional: pin every chat to one repository instead of letting people pick
# from the repositories connected to Cursor. Used for the hosted demo.
# NEXT_PUBLIC_LOCKED_REPO=https://github.com/liveblocks/demo-comments-hover-boostr
# NEXT_PUBLIC_LOCKED_REPO_REF=main
