# https://liveblocks.io/dashboard/apikeys
LIVEBLOCKS_SECRET_KEY=

# Cursor API key used to run the cloud agent that edits the repository.
# Create one at https://cursor.com/dashboard -> API Keys. The account must
# have GitHub connected with push access to the repository in lib/repo.ts.
# Cloud agent runs are billed to this key at API pricing.
CURSOR_API_KEY=

# Optional: default model for new chats (people can switch per chat).
CURSOR_MODEL=composer-2.5
