{
  "name": "@liveblocks-examples/nextjs-ai-slideshow",
  "description": "This example shows how to build a multiplayer AI slideshow builder with Liveblocks, Yjs, CodeMirror, comments, and Next.js.",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "fix": "prettier --write . && eslint . --fix",
    "lint:structure": "node scripts/check-structure.mjs",
    "graph": "node scripts/check-structure.mjs --graph",
    "owner": "node scripts/check-structure.mjs --owner",
    "test": "vitest run",
    "test:baseline": "node scripts/check-test-baseline.mjs",
    "e2e": "playwright test",
    "check": "npm run format:check && npm run lint:structure && npm run typecheck && npm run lint && npm run test:baseline",
    "check:feature": "node scripts/check-feature.mjs",
    "check:all": "npm run check && npm run e2e",
    "new:feature": "node scripts/new-feature.mjs",
    "env:check": "node scripts/env-check.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
