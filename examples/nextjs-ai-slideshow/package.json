    "@dnd-kit/utilities": "^3.2.2",
    "@liveblocks/node": "^3.23.0",
    "@liveblocks/react": "^3.23.0",
    "@liveblocks/react-ui": "^3.23.0",
    "@liveblocks/yjs": "^3.23.0",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "ai": "^6.0.205",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "fast-diff": "^1",
    "html-to-image": "^1",
    "lucide-react": "^0.475.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "next": "16.3.8",
    "parse5": "^8.0.1",
    "pptxgenjs": "^4",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shiki": "^4.2.0",
    "streamdown": "^1.6.11",
    "tailwind-merge": "^3.3.1",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "y-codemirror.next": "^0.3.5",
    "yjs": "^13.6.29"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
