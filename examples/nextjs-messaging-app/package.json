{
  "name": "@liveblocks-examples/nextjs-messaging-app",
  "description": "This example shows how to build a Slack-like messaging app with Liveblocks Feeds, Storage, Presence, and Next.js.",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "NEXT_DIST_DIR=.next-local liveblocks dev -P --no-check -c \"next dev --port 3100\"",
    "build": "next build",
    "start": "next start",
    "new:feature": "node scripts/scaffold.mjs feature",
    "new:view": "node scripts/scaffold.mjs view",
    "new:primitive": "node scripts/scaffold.mjs primitive",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:structure": "node scripts/check-structure.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:baseline": "vitest run --reporter=default --reporter=json --outputFile=test-results/vitest.json && node scripts/check-test-baseline.mjs",
    "test:e2e": "liveblocks dev -P --no-check -c \"playwright test\"",
    "test:e2e:cloud": "E2E_BACKEND=cloud playwright test",
    "check": "npm run typecheck && npm run lint && npm run lint:structure && npm run format:check && npm run test:baseline",
    "check:all": "npm run check && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^7.0.2",
    "@dnd-kit/utilities": "^3.2.2",
    "@liveblocks/client": "^3.23.0",
    "@liveblocks/node": "^3.23.0",
    "@liveblocks/react": "^3.23.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@tiptap/extension-mention": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "@tiptap/suggestion": "^3.13.0",
    "ai": "^6.0.205",
    "clsx": "^2.1.1",
    "frimousse": "^0.3.0",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.1.11",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.1",
    "jsdom": "^29.1.1",
    "liveblocks": "^1.9.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
