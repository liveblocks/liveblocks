# Get your Liveblocks secret key from https://liveblocks.io/dashboard/apikeys
LIVEBLOCKS_SECRET_KEY=

# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials).
# Add `http://localhost:3000/api/auth/callback/google` as an authorized
# redirect URI. Without these, only the demo accounts are offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: secret used to encrypt session cookies. Falls back to the
# Liveblocks secret key when unset.
BETTER_AUTH_SECRET=

# Optional: lets the @AI Assistant in the chat answer and edit documents
# through the Vercel AI Gateway (https://vercel.com/docs/ai-gateway).
# Without it, the assistant runs in a demo mode with canned edits.
AI_GATEWAY_API_KEY=

# Optional: tldraw license key (https://tldraw.dev/#pricing). Hides the
# "Made with tldraw" watermark, which the tldraw license otherwise requires.
TLDRAW_LICENSE_KEY=

# Optional: only when running against the local Liveblocks dev server
# (`npx liveblocks dev --port 1153`).
# LIVEBLOCKS_BASE_URL=http://localhost:1153
# NEXT_PUBLIC_LIVEBLOCKS_BASE_URL=http://localhost:1153
