# https://liveblocks.io/dashboard/apikeys
LIVEBLOCKS_SECRET_KEY=sk_xxx

# Optional — connect a real Resend inbox to send and receive email.
# Without these, the app runs in demo mode: the sample conversations work and
# replies are recorded for the team but clearly marked as simulated.
# https://resend.com/api-keys
RESEND_API_KEY=
# The inbox id (inb_…) or its email address, e.g. support@yourdomain.com
# https://resend.com/docs/dashboard/inboxes/introduction
RESEND_INBOX_ID=
# Signing secret of the Resend webhook pointed at /api/webhooks/resend and
# subscribed to `inbox.email.received` (and `inbox.email.sent`).
# https://resend.com/webhooks
RESEND_WEBHOOK_SECRET=
